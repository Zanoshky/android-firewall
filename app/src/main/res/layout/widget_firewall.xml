<?xml version="1.0" encoding="utf-8"?><!--
  Home screen widget: whether protection is on, what it stopped today, and a
  switch. Only views RemoteViews can inflate are used here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/widgetShield"
        android:layout_width="30dp"
        android:layout_height="34dp"
        android:contentDescription="@string/hero_shield_description"
        android:src="@drawable/ic_shield" />

    <LinearLayout
        android:id="@+id/widgetBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/widgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/status_protected"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widgetStopped"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetTrackers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/accent_orange"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetToggle"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_chip"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/action_turn_off"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
