    <!-- The tracker lists on offer. The names are the projects own names. -->
    <string name="source_desc_hagezi_light">Curated list blocking ads, tracking and metrics. Low false positives. About 35K domains.</string>
    <string name="source_desc_oisd_small">Block without breaking. Minimal false positives, updated hourly. About 57K domains.</string>
    <string name="source_desc_1hosts_lite">Lightweight tier of a well maintained multi source blocklist. About 195K domains.</string>
    <string name="source_desc_steven_black">The classic merged hosts file from several curated sources. About 170K domains.</string>
    <string name="source_desc_adguard_dns">Used by AdGuard public DNS. Conservative, well tested. About 166K domains.</string>

