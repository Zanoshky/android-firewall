default_platform(:android)

platform :android do

  desc "Build debug APK"
  lane :debug do
    gradle(task: "assembleDebug")
  end

  desc "Build signed release APK and AAB"
  lane :build_release do
    gradle(
      task: "bundleRelease",
      properties: {
        "android.injected.signing.store.file" => File.expand_path(ENV["KEYSTORE_PATH"] || "firewall-release.jks", File.expand_path("..", __dir__)),
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"] || "firewall",
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
  end

  desc "Build and upload to internal testing"
  lane :internal do
    build_release
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and upload to closed testing (beta)"
  lane :beta do
    build_release
    upload_to_play_store(
      track: "beta",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and upload to production"
  lane :release do
    build_release
    upload_to_play_store(
      track: "production",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true
    )
  end

  # A changelog belongs to one version code, and a run that uploads no binary has
  # no version code to attach it to. Asking for both fails the whole edit with
  # "Cannot find changelog because no version code given", which takes the store
  # listing down with it. So the metadata lanes never touch changelogs; the
  # release lane carries them up with the build they describe.
  desc "Upload metadata only (title and descriptions)"
  lane :metadata do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload metadata, icon, feature graphic and screenshots"
  lane :metadata_full do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end

  desc "Upload screenshots only"
  lane :screenshots do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true
    )
  end

  desc "Validate metadata without uploading (dry run)"
  lane :validate do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      validate_only: true
    )
  end

  # A promotion moves a build that is already on Play, so it needs that build's
  # version code: without one the changelogs have nothing to attach to and the
  # whole edit fails with "Cannot find changelog because no version code given".
  # It also leaves the store listing alone; that is what the metadata lanes are for.
  desc "Promote internal to beta"
  lane :promote_to_beta do |options|
    promote(from: "internal", to: "beta", version_code: options[:version_code])
  end

  desc "Promote beta to production"
  lane :promote_to_production do |options|
    promote(from: "beta", to: "production", version_code: options[:version_code])
  end

  private_lane :promote do |options|
    code = options[:version_code] ||
      google_play_track_version_codes(track: options[:from]).max
    UI.user_error!("No build on the #{options[:from]} track to promote") unless code
    upload_to_play_store(
      track: options[:from],
      track_promote_to: options[:to],
      version_code: code.to_i,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

end
